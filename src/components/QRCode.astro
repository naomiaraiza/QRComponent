---
import qrImg from "../images/image-qr-code.png";
---

<div class="bg-white rounded-2xl shadow-lg p-3 w-72 text-center">
	<figure>
		<img src={qrImg.src} alt="QR code" class="w-full rounded-lg mb-4" />
	</figure>
	<div class="text-content">
		<h2 class="text-slate-900 text-xl font-bold mt-4 leading-tight">
			Improve your front-end skills by building projects
		</h2>
		<p class="text-slate-500 text-[14px] mx-4 mt-4 mb-5">
			Scan the QR code to visit Frontend Mentor and take your coding skills to the next level
		</p>
	</div>
</div>